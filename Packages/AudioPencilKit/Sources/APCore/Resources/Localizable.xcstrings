    "Short messages": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes cortos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages courts"
          }
        }
      }
    },
    "Summarise a recent conversation or meeting for someone who missed it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume una conversación o reunión reciente para alguien que se la perdió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumez une conversation ou une réunion récente pour quelqu’un qui l’a manquée."
          }
        }
      }
    },
    "Tap %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsar %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher %@"
          }
        }
      }
    },
    "Technical explanation": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicación técnica"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explication technique"
          }
        }
      }
    },
    "Tell a colleague or client that something is running late, why, and what happens next.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntale a un compañero o cliente que algo va con retraso, por qué y qué pasará ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annoncez à un collègue ou un client qu’une chose est en retard, pourquoi, et la suite."
          }
        }
      }
    },
    "Transcript": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription"
          }
        }
      }
    },
    "Work email": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correo de trabajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail professionnel"
          }
        }
      }
    },
    "Write a few honest paragraphs about how today actually went.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe unos párrafos sinceros sobre cómo ha ido de verdad tu día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez quelques paragraphes sincères sur la façon dont s’est vraiment passée votre journée."
          }
        }
      }
    },
    "Write step-by-step instructions for a task you know well, around the house or on a computer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe paso a paso cómo hacer algo que conozcas bien, en casa o en el ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez les étapes d’une tâche que vous connaissez bien, à la maison ou sur ordinateur."
          }
        }
      }
    },
    "Write three quick texts: making plans, turning something down, and thanking someone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe tres mensajes rápidos: para quedar, para rechazar algo y para dar las gracias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez trois messages rapides : pour fixer un rendez-vous, décliner quelque chose et remercier quelqu’un."
          }
        }
      }
    },
