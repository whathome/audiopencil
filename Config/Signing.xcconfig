// Code signing.
//
// Default: ad-hoc ("Sign to Run Locally"). Builds anywhere, but macOS treats every
// rebuild as a new app, so Accessibility must be re-granted after each build.
//
// For stable permissions, sign with your free Personal Team: add your Apple ID in
// Xcode > Settings > Accounts, then create Config/Signing.local.xcconfig (gitignored):
//
//     DEVELOPMENT_TEAM = ABCDE12345
//     CODE_SIGN_IDENTITY = Apple Development
//
// scripts/set-team.sh writes that file for you.

CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
