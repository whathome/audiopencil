      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre"
          }
        }
      }
    },
    "Resume Recording": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanudar la grabación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre l’enregistrement"
          }
        }
      }
    },
    "Start Recording": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar a grabar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer à enregistrer"
          }
        }
      }
    },
    "Starts an Audio Pencil recording, or stops and saves the one that's running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza una grabación de Audio Pencil, o para y guarda la que está en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un enregistrement Audio Pencil, ou arrête et sauvegarde celui en cours."
          }
        }
      }
    },
    "Starts recording a note in Audio Pencil, or stops and saves the recording that's running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a grabar una nota en Audio Pencil, o para y guarda la grabación en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence l’enregistrement d’une note dans Audio Pencil, ou arrête et sauvegarde celui en cours."
          }
        }
      }
    },
    "Starts recording a note in Audio Pencil.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a grabar una nota en Audio Pencil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence l’enregistrement d’une note dans Audio Pencil."
          }
        }
      }
    },
