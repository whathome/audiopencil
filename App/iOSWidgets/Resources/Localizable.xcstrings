{
  "sourceLanguage": "en",
  "strings": {
    "Carries on a paused recording.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanuda una grabación en pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend un enregistrement en pause."
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        }
      }
    },
    "Pause Recording": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar la grabación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre l’enregistrement en pause"
          }
        }
      }
    },
    "Paused": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause"
          }
        }
      }
    },
    "Pauses the recording; resume it to carry on in the same note.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa la grabación; reanúdala para seguir en la misma nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met l’enregistrement en pause ; reprenez-le pour continuer dans la même note."
          }
        }
      }
    },
    "Record a Note": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar una nota"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer une note"
          }
        }
      }
    },
    "Record or Stop": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabar o parar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer ou arrêter"
          }
        }
      }
    },
    "Recording": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement"
          }
        }
      }
    },
