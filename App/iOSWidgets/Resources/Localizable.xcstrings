      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter"
          }
        }
      }
    },
    "Stop Recording": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar la grabación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter l’enregistrement"
          }
        }
      }
    },
    "Stops the recording and makes it a note in your last style.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la grabación y la convierte en una nota en tu último estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête l’enregistrement et en fait une note dans votre dernier style."
          }
        }
      }
    }
