    "%@ to dictate in a style. Press its number while you talk to switch.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ para dictar con un estilo. Pulsa su número mientras hablas para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pour dicter dans un style. Appuyez sur son numéro pendant que vous parlez pour en changer."
          }
        }
      }
    },
    "%@ uses a quicker starter model until the more accurate one is ready, in about %lld min.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ uses a quicker starter model until the more accurate one is ready, in about %2$lld min."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras se prepara el modelo más preciso (listo en unos %2$lld min), %1$@ usa un modelo inicial más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attendant le modèle plus précis (prêt dans environ %2$lld min), %1$@ utilise un modèle de démarrage plus rapide."
          }
        }
      }
    },
    "%@ uses a quicker starter model until the more accurate one is ready.": {
      "localizations": {
