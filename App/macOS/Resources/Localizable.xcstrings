    "Step %lld of %lld: %@. Happens once per model; dictation waits until it's done.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Step %1$lld of %2$lld: %3$@. Happens once per model; dictation waits until it's done."
