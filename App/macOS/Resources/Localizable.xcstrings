    "%lld samples. For each note, Like me shows the model your two closest samples. More variety means a better match.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sample. For each note, Like me shows the model your two closest samples. More variety means a better match."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld samples. For each note, Like me shows the model your two closest samples. More variety means a better match."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld muestra. En cada nota, Como yo enseña al modelo tus dos muestras más parecidas. Cuanta más variedad, mejor se parece."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld muestras. En cada nota, Como yo enseña al modelo tus dos muestras más parecidas. Cuanta más variedad, mejor se parece."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld exemple. Pour chaque note, Comme moi montre au modèle vos deux exemples les plus proches. Plus il y a de variété, plus la ressemblance est bonne."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld exemples. Pour chaque note, Comme moi montre au modèle vos deux exemples les plus proches. Plus il y a de variété, plus la ressemblance est bonne."
                }
              }
            }
          }
        }
      }
    },
