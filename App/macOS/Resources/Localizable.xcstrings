    "Click here, tap %@, and start talking.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic aquí, pulsa %@ y empieza a hablar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez ici, touchez %@ et parlez."
          }
        }
      }
    },
    "Click to also add this to the daily note or your file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para añadirlo también a la nota diaria o a tu archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour l'ajouter aussi à la note quotidienne ou à votre fichier."
          }
