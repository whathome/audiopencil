      }
    },
    "This model": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle"
          }
        }
      }
    },
    "Three sample notes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres notas de ejemplo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois notes d’exemple"
          }
        }
      }
    },
    "Tidies a spoken diary entry: removes filler and repeats, fixes punctuation, adds paragraphs. Never changes your wording.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena una entrada de diario hablada: quita muletillas y repeticiones, corrige la puntuación y añade párrafos. Nunca cambia tus palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met au propre une entrée de journal parlée : enlève les tics et les répétitions, corrige la ponctuation, ajoute des paragraphes. Ne change jamais vos mots."
          }
        }
      }
    },
    "Time saved": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo ahorrado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps gagné"
          }
        }
      }
    },
    "Tip: press the number while you talk": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: pulsa el número mientras hablas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : appuyez sur le numéro pendant que vous parlez"
          }
        }
      }
    },
    "To hear you while you dictate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para oírte mientras dictas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vous entendre pendant la dictée."
          }
        }
      }
    },
    "To notice the dictation key and paste into the app you're using.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detectar la tecla de dictado y pegar en la app que estás usando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour repérer la touche de dictée et coller dans l’app que vous utilisez."
          }
        }
      }
    },
    "To record the call app's audio. Optional for dictation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para grabar el audio de la app de llamadas. Opcional para dictar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer l'audio de l'app d'appel. Facultatif pour la dictée."
          }
        }
      }
    },
    "To see the hotkey and paste into the active field.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detectar el atajo y pegar en el campo activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour détecter le raccourci et coller dans le champ actif."
          }
        }
      }
    },
    "Tone": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tono"
          }
