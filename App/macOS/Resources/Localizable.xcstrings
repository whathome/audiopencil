          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un long enregistrement est prêt, vous recevez une notification. Approuvez son titre, ses tags et son dossier, ou passez-le : il attend sur le tableau en needs-review."
