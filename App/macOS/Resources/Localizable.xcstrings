    "This folder is now an Obsidian vault. Add the review board and guide?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta ya es una bóveda de Obsidian. ¿Añadir el tablero de revisión y la guía?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est maintenant un coffre Obsidian. Ajouter le tableau de relecture et le guide ?"
          }
