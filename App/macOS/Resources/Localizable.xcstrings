    "Double-tap to start, tap again to stop and paste. Esc cancels. More choices are in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Doble toque para empezar, un toque para parar y pegar. Esc cancela. Hay más opciones en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour commencer, une fois pour arrêter et coller. Échap annule. D’autres choix sont dans les Réglages."
          }
        }
      }
    },
