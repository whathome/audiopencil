    "Press and hold, talk, release to paste. Pressing another key while holding cancels, so %@ still works as a modifier.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada, habla y suelta para pegar. Pulsar otra tecla mientras la mantienes cancela, así que %@ sigue funcionando como tecla modificadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez, parlez, relâchez pour coller. Appuyer sur une autre touche pendant le maintien annule, donc %@ reste utilisable comme touche de modification."
