            "value": "Dossier des notes"
          }
        }
      }
    },
    "Notes go to each style's folder (set on the Styles page), or %@. Audio goes to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Notes go to each style's folder (set on the Styles page), or %1$@. Audio goes to %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas van a la carpeta de cada estilo (se define en la página Estilos) o a %@. El audio va a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes vont dans le dossier de chaque style (réglé dans la page Styles), sinon dans %@. L’audio va dans %@."
