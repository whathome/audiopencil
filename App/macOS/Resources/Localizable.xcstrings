        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est téléchargé et préparé. Essayez une dictée ci-dessous."
          }
        }
      }
    },
    "Everything runs on this Mac, so it needs a few models. They download once and get prepared for this Mac's chip, in the background.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo funciona en este Mac, así que necesita algunos modelos. Se descargan una vez y se preparan para el chip de este Mac, en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout fonctionne sur ce Mac, il lui faut donc quelques modèles. Ils se téléchargent une fois et sont préparés pour la puce de ce Mac, en arrière-plan."
          }
        }
      }
    },
