    "“Press 🌐 key to” is set to %@. Set it to Do Nothing so double-tapping Fn doesn't also trigger that. Also make sure the Dictation shortcut isn't “Press 🌐 twice”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Pulsar la tecla 🌐 para» está en %@. Ponlo en No hacer nada para que pulsar Fn dos veces no active también eso. Comprueba además que el atajo de Dictado no sea «Pulsar 🌐 dos veces»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Appuyer sur la touche 🌐 pour » est réglé sur %@. Réglez-le sur Ne rien faire pour que toucher deux fois Fn ne déclenche pas aussi cette action. Vérifiez aussi que le raccourci de Dictée n’est pas « Appuyer deux fois sur 🌐 »."
          }
        }
      }
    },
    "“Press 🌐 key to” is set to Do Nothing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Pulsar la tecla 🌐 para» está en No hacer nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Appuyer sur la touche 🌐 pour » est réglé sur Ne rien faire."
          }
        }
      }
    }
