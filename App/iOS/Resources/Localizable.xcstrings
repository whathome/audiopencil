    "While locked": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el iPhone bloqueado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillé"
          }
        }
      }
    },
    "With no new words for this long, the recording stops, the quiet end is dropped, and the note is made as usual.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no hay palabras nuevas durante este tiempo, la grabación se detiene, se quita el final en silencio y la nota se crea como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans nouveaux mots pendant cette durée, l’enregistrement s’arrête, la fin silencieuse est retirée et la note est créée comme d’habitude."
          }
        }
      }
    },
    "Without opening the app": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin abrir la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans ouvrir l’app"
          }
        }
      }
    },
