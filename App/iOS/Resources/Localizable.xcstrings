            "state": "translated",
            "value": "Volume"
          }
        }
      }
    },
    "Waiting for storage": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al almacenamiento"
          }
        },
        "fr": {
