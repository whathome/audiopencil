            "value": "L’enregistrement est sauvegardé. Ouvrez Audio Pencil pour le rédiger en %@."
          }
        }
      }
    },
    "The writing model isn't on this iPhone yet, so the note keeps the transcript as spoken.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de redacción aún no está en este iPhone, así que la nota conserva la transcripción tal como se dijo."
          }
        },
        "fr": {
