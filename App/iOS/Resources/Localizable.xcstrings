    "Step %lld of %lld: %@. Happens once per model; dictation waits until it's done.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Step %1$lld of %2$lld: %3$@. Happens once per model; dictation waits until it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso %lld de %lld: %@. Solo una vez por modelo; el dictado espera a que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étape %lld sur %lld : %@. Une seule fois par modèle ; la dictée attend la fin."
          }
        }
      }
    },
    "Step %lld of %lld: %@. Runs in the background; dictation keeps working.": {
