    "Written up one at a time while Audio Pencil is open; leaving or recording pauses it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se redactan de una en una mientras Audio Pencil está abierto; salir o grabar lo pausa."
