    "Audio Pencil": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Pencil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Pencil"
          }
        }
      }
    },
    "Audio Pencil listens only while you record. The speech model starts downloading now, so it's ready when you are.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Pencil solo escucha mientras grabas. El modelo de voz empieza a descargarse ahora, para que esté listo cuando tú lo estés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Pencil n’écoute que pendant l’enregistrement. Le modèle vocal commence à se télécharger maintenant, pour être prêt quand vous le serez."
          }
        }
      }
    },
    "Audio Pencil needs the microphone. Allow it in Settings › Privacy & Security › Microphone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Pencil necesita el micrófono. Permítelo en Ajustes › Privacidad y seguridad › Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio Pencil a besoin du micro. Autorisez-le dans Réglages › Confidentialité et sécurité › Micro."
          }
        }
      }
    },
