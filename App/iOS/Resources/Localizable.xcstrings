    "Each is prepared for this iPhone's chip the first time it's used, which takes a few minutes once.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uno se prepara para el chip de este iPhone la primera vez que se usa, lo que lleva unos minutos una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun est préparé pour la puce de cet iPhone à sa première utilisation, ce qui prend quelques minutes une seule fois."
          }
        }
      }
    },
    "Each model downloads once and is prepared for this iPhone's chip the first time it's used.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modelo se descarga una vez y se prepara para el chip de este iPhone la primera vez que se usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modèle se télécharge une fois et est préparé pour la puce de cet iPhone à sa première utilisation."
          }
        }
      }
    },
    "Each recording becomes a Markdown note with its audio, in Obsidian or any folder, on Nextcloud or iCloud Drive.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada grabación se convierte en una nota Markdown con su audio, en Obsidian o en cualquier carpeta, en Nextcloud o iCloud Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque enregistrement devient une note Markdown avec son audio, dans Obsidian ou n’importe quel dossier, sur Nextcloud ou iCloud Drive."
          }
        }
      }
    },
