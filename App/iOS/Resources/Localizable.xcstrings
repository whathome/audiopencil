          }
        }
      }
    },
    "Recording saved": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación guardada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement sauvegardé"
          }
        }
      }
    },
    "Recordings become notes: written up in a style, with their audio, filed in your notes folder. Review them on your Obsidian board.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones se convierten en notas: redactadas en un estilo, con su audio, archivadas en tu carpeta de notas. Revísalas en tu tablero de Obsidian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements deviennent des notes : rédigées dans un style, avec leur audio, classées dans votre dossier de notes. Relisez-les sur votre tableau Obsidian."
          }
        }
      }
    },
    "Recordings started or stopped this way show on the Lock Screen with their clock, and are written up in your last style. If the app isn't open when one stops, it's saved and written up the next time you open Audio Pencil.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones que empiezan o terminan así aparecen en la pantalla bloqueada con su reloj y se redactan en tu último estilo. Si la app no está abierta cuando una termina, se guarda y se redacta la próxima vez que abras Audio Pencil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements lancés ou arrêtés ainsi apparaissent sur l’écran verrouillé avec leur durée, et sont rédigés dans votre dernier style. Si l’app n’est pas ouverte à l’arrêt, l’enregistrement est sauvegardé et rédigé à la prochaine ouverture d’Audio Pencil."
          }
        }
