    "Any server that speaks WebDAV: a Synology, ownCloud, a hosting provider.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier servidor WebDAV: un Synology, ownCloud, un proveedor de alojamiento."
