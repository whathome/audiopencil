        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigées une à la fois pendant qu'Audio Pencil est ouvert ; quitter l'app ou enregistrer met en pause."
          }
        }
      }
    },
    "Written while Audio Pencil is open.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
