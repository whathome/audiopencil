    "Walk and talk. Your iPhone writes it up as a note, on the iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camina y habla. Tu iPhone lo convierte en una nota, en el propio iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez et parlez. Votre iPhone en fait une note, sur l’iPhone."
          }
        }
      }
    },
    "Watch the words arrive. Pause when you need to.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cómo llegan las palabras. Haz una pausa cuando lo necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
