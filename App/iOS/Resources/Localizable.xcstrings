    "Couldn't copy it: your storage can't be reached, and this note's text isn't on this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo copiar: no se puede acceder a tu almacenamiento y el texto de esta nota no está en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie impossible : votre stockage est injoignable et le texte de cette note n'est pas sur cet appareil."
