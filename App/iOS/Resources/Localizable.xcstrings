          }
        }
      }
    },
    "Private by design": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado por diseño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé par conception"
          }
        }
      }
    },
    "Private, on-device. Audio and text stay on this iPhone until you file a note in your own storage.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado, en el dispositivo. El audio y el texto se quedan en este iPhone hasta que archivas una nota en tu propio almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé, sur l’appareil. L’audio et le texte restent sur cet iPhone jusqu’à ce que vous rangiez une note dans votre propre stockage."
          }
        }
      }
    },
    "Professional": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
