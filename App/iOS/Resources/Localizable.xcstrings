    "Polished text, summaries and key points, plus suggested titles and tags. Without it, notes keep the transcript as spoken.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto pulido, resúmenes y puntos clave, además de títulos y etiquetas sugeridos. Sin él, las notas conservan la transcripción tal como se dijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte soigné, résumés et points clés, plus des titres et tags suggérés. Sans lui, les notes gardent la transcription telle que dite."
          }
        }
      }
    },
    "Preparing Whisper %@ for this iPhone": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando Whisper %@ para este iPhone"
          }
        },
        "fr": {
