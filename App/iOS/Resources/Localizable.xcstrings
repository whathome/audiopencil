            "state": "translated",
            "value": "Reanudar la grabación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre l’enregistrement"
          }
        }
      }
    },
    "Reviewed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relue"
          }
        }
      }
    },
    "Rewrites it as clear, natural written text: no filler or false starts, grammar fixed, meaning, details, voice and length kept. No headings or bullets.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo reescribe como un texto claro y natural: sin muletillas ni arranques en falso, con la gramática corregida y conservando el sentido, los detalles, la voz y la longitud. Sin títulos ni viñetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réécrit en texte clair et naturel : sans tics de langage ni faux départs, grammaire corrigée, sens, détails, ton et longueur conservés. Sans titres ni listes."
          }
        }
      }
    },
    "Rewrites it the way you write, matching the tone and habits of your writing samples.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo reescribe como escribes tú, con el tono y las costumbres de tus muestras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réécrit comme vous écrivez, en reprenant le ton et les habitudes de vos exemples."
          }
        }
      }
    },
