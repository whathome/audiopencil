    "Uses the iPhone's voice processing on the microphone. Turn it off if voices sound muffled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el procesado de voz del iPhone en el micrófono. Desactívalo si las voces suenan apagadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le traitement de la voix de l’iPhone sur le micro. Désactivez-le si les voix semblent étouffées."
          }
        }
      }
    },
    "Volume": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen"
          }
        },
        "fr": {
